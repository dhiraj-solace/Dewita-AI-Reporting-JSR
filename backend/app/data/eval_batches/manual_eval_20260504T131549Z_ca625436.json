      "id": "d6345d32-1ee8-4773-aef3-84d210ffbe12",
      "question": "Show April 2026 revision summary by project and team leader",
      "report": {
        "title": "April 2026 Revision Summary by Project and Team Leader",
        "sql": "SELECT p.project_name, u.name AS team_leader_name, COUNT(cm.id) AS revision_count, SUM(cm.changerequest_detailing_estimated_hrs) AS total_detailing_estimated_hrs, SUM(cm.changerequest_checking_estimated_hrs) AS total_checking_estimated_hrs, AVG(cm.effective_percentage) AS avg_effective_percentage FROM changerequest_management cm JOIN projects p ON cm.project_id = p.id LEFT JOIN users u ON p.primary_team_leader = u.id WHERE cm.date BETWEEN '2026-04-01' AND '2026-04-30' AND cm.is_deleted = 0 GROUP BY p.project_name, u.name ORDER BY p.project_name\nLIMIT 500",
        "explanation": "This query retrieves revision summary data for April 2026 by joining the changerequest_management table (which stores revision/CR records) with projects and users tables. It filters by the date range 2026-04-01 to 2026-04-30, excludes deleted records, and groups results by project name and team leader name. The metrics include revision count, total estimated hours for detailing and checking, and average effective percentage.",
        "assumptions": [
          "Interpreted the requested period as April 2026.",
          "Revision records are stored in changerequest_management table as per the schema documentation",
          "Project names are retrieved from projects.project_name",
          "Team leader names come from users.name joined via projects.primary_team_leader",
          "The date field in changerequest_management represents when the revision was created/added"
        ],
        "columns": [
          "project_name",
          "team_leader_name",
          "revision_count",
          "total_detailing_estimated_hrs",
          "total_checking_estimated_hrs",
          "avg_effective_percentage"
        ],
