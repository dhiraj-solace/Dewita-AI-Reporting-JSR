      "id": "970eb30e-0651-4876-adb1-58b7ba3385fd",
      "question": "Top team leaders by equivalent new tickets this month ",
      "report": {
        "title": "Top Team Leaders by New Tickets This Month",
        "sql": "SELECT u.name AS team_leader_name, COUNT(pt.id) AS new_tickets_count FROM product_task pt JOIN users u ON pt.assign_team_leader = u.id WHERE pt.created_at >= '2026-05-01' AND pt.created_at <= '2026-05-31' AND pt.is_deleted = 0 GROUP BY u.id, u.name ORDER BY new_tickets_count DESC\nLIMIT 500",
        "explanation": "This query counts new tickets (product_task records) created in May 2026 for each team leader. It joins the product_task table with the users table to get team leader names, filters for non-deleted tasks created within the specified date range, groups by team leader, and orders by ticket count descending to show top team leaders.",
        "assumptions": [
          "Interpreted 'this month' as May 2026.",
          "New tickets are defined as product_task records created in the specified month",
          "Team leader is identified by the assign_team_leader field in product_task",
          "Only non-deleted tasks (is_deleted = 0) are counted",
          "The created_at field represents when the ticket was created"
        ],
        "columns": [
          "team_leader_name",
          "new_tickets_count"
        ],
