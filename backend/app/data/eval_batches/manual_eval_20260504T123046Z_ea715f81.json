      "question": " Show projects where completion percentage is above 50 percent",
      "report": {
        "title": "Projects with Completion Percentage Above 50%",
        "sql": "SELECT p.id, p.project_name, p.effective_percentage, p.project_status, p.start_date, p.actual_end_date FROM projects p WHERE p.effective_percentage > 50\nLIMIT 500",
