      "id": "cf4dc3ff-3849-4f6a-a860-48afa19e566c",
      "question": "Top team leaders by equivalent new tickets this year",
      "report": {
        "title": "Top team leaders by equivalent new tickets this year",
        "sql": "SELECT u.name AS team_leader_name, COUNT(pt.id) AS new_ticket_count FROM product_task pt JOIN users u ON pt.assign_team_leader = u.id WHERE pt.created_at >= '2026-01-01' AND pt.created_at <= '2026-12-31' AND pt.is_deleted = 0 GROUP BY u.id, u.name ORDER BY new_ticket_count DESC\nLIMIT 500",
        "explanation": "This query counts new tickets (product_task records) created in 2026, grouped by team leader. It joins product_task with users to get team leader names, filters for non-deleted tasks within the specified date range, and orders by ticket count descending to show top team leaders.",
        "assumptions": [
          "Interpreted 'this year' as calendar year 2026.",
          "New tickets are defined as product_task records created in the given year",
          "Team leaders are identified by the assign_team_leader field in product_task",
          "Only non-deleted tasks (is_deleted = 0) are counted",
          "The created_at field in product_task represents when the ticket was created"
        ],
        "columns": [
          "team_leader_name",
          "new_ticket_count"
        ],
        "sample_rows": [
