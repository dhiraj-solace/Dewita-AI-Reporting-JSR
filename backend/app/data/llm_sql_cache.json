      },
      "response": {
        "explanation": "",
        "sql": "SELECT p.project_name, u.name AS team_leader_name, COUNT(cm.id) AS revision_count FROM changerequest_management cm JOIN projects p ON cm.project_id = p.id JOIN users u ON p.primary_team_leader = u.id WHERE cm.date BETWEEN '2026-04-01' AND '2026-04-30' GROUP BY p.id, u.id ORDER BY revision_count DESC LIMIT 10",
