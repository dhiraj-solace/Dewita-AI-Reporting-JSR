      "key": "003436a35b721542f87d280b69a395b0c883b05fb6a5bcd8921eaed3d6dee1ea",
      "query": {
        "normalized": "show june 2026 revision summary by project and team leader",
        "original": "Show June 2026 revision summary by project and team leader"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT \n    p.project_name, \n    u.name AS team_leader_name, \n    COUNT(cm.id) AS revision_count\nFROM \n    changerequest_management cm\nJOIN \n    projects p ON cm.project_id = p.id\nJOIN \n    users u ON p.primary_team_leader = u.id\nWHERE \n    cm.date BETWEEN '2026-06-01' AND '2026-06-30'\nGROUP BY \n    p.id, u.id\nORDER BY \n    revision_count DESC\nLIMIT 10",
        "title": "SQL Report"
      },
      "sources": {
        "schema_version": "ecb2b73f92f14b42"
      },
