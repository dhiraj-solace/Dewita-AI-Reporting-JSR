      "key": "52822310166876f5317e5ad1ea1808561c8efbd1a7a5fed55d7ef7471dbfc47f",
      "query": {
        "normalized": "week 5 report with totals grouped by project type",
        "original": "Week 5 report with totals grouped by project type"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT \n    pt.name AS project_type_name,\n    COUNT(pdt.id) AS ticket_count\nFROM \n    project_type pt\nLEFT JOIN \n    projects p ON pt.id = p.project_type_id\nLEFT JOIN \n    product_task pdt ON p.id = pdt.project_id AND pdt.is_deleted = 0\nGROUP BY \n    pt.id, pt.name\nORDER BY \n    ticket_count DESC\nLIMIT 100",
        "title": "SQL Report"
      },
      "sources": {
        "schema_version": "ecb2b73f92f14b42"
      },
