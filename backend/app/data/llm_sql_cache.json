        "original": "Top team leaders by equivalent new tickets this year"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT \n    u.name AS team_leader_name,\n    COUNT(pt.id) AS new_ticket_count\nFROM product_task pt\nJOIN users u ON pt.assign_team_leader = u.id\nWHERE pt.created_at BETWEEN '2026-01-01' AND '2026-12-31'\n    AND pt.is_deleted = 0\n    AND pt.assign_team_leader IS NOT NULL\nGROUP BY pt.assign_team_leader, u.name\nORDER BY new_ticket_count DESC\nLIMIT 10",
