      "query": {
        "normalized": "top team leaders by equivalent new tickets this year",
        "original": "Top team leaders by equivalent new tickets this year"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT u.name AS team_leader_name, COUNT(pt.id) AS equivalent_new_tickets\nFROM product_task pt\nJOIN users u ON pt.assign_team_leader = u.id\nWHERE pt.created_at >= '2026-01-01' \n  AND pt.created_at <= '2026-12-31'\n  AND pt.is_deleted = 0\n  AND pt.assign_team_leader IS NOT NULL\nGROUP BY u.id, u.name\nORDER BY equivalent_new_tickets DESC\nLIMIT 10",
        "title": "SQL Report"
      },
