      "key": "6bfa98d911a52c1e99514aea56676863e16f8886c35d734ffafad0acb5c122ff",
      "query": {
        "normalized": "show april 2026 revision summary by project and team leader",
        "original": "Show April 2026 revision summary by project and team leader"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT \n    p.project_name,\n    u.name AS team_leader_name,\n    COUNT(cm.id) AS revision_count\nFROM \n    changerequest_management cm\nJOIN \n    projects p ON cm.project_id = p.id\nJOIN \n    users u ON p.primary_team_leader = u.id\nWHERE \n    cm.date BETWEEN '2026-04-01' AND '2026-04-30'\nGROUP BY \n    p.id, u.id\nORDER BY \n    revision_count DESC\nLIMIT 10",
        "title": "SQL Report"
      },
