      "key": "98ef54ecb4ce633e9210e60f17f002dc6960b9ad00b6bfabca440b8cdcf3926e",
      "query": {
        "normalized": "projects where actual revision hours are greater than assigned hours",
        "original": "Projects where actual revision hours are greater than assigned hours"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT p.project_name, SUM(COALESCE(tl.hours, 0) + COALESCE(tl.minutes, 0) / 60.0) AS actual_hours, SUM(COALESCE(cm.changerequest_detailing_estimated_hrs, 0) + COALESCE(cm.changerequest_checking_estimated_hrs, 0)) AS assigned_hours FROM changerequest_management cm JOIN projects p ON cm.project_id = p.id LEFT JOIN timelog_records tl ON cm.task_id = tl.task_id AND cm.project_id = tl.project_id WHERE cm.is_deleted = 0 GROUP BY p.id, p.project_name HAVING actual_hours > assigned_hours LIMIT 100",
        "title": "SQL Report"
      },
      "sources": {
        "schema_version": "ecb2b73f92f14b42"
      },
