      "query": {
        "normalized": "top team leaders by equivalent new tickets from 2026",
        "original": "Top team leaders by equivalent new tickets from 2026"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT u.name AS team_leader, COUNT(pt.id) AS new_tickets\nFROM product_task pt\nJOIN users u ON pt.assign_team_leader = u.id\nWHERE pt.created_at BETWEEN '2026-01-01' AND '2026-12-31'\n  AND pt.is_deleted = 0\nGROUP BY u.id, u.name\nORDER BY new_tickets DESC\nLIMIT 10",
        "title": "SQL Report"
      },
