      "key": "c31a76c1fb466e34a3202d4327b683b27caacecfdc80c450de3230d07ea8b452",
      "query": {
        "normalized": "show june 2025 attendece report corresponding with projects",
        "original": "Show june 2025 attendece report corresponding with projects"
      },
      "response": {
        "explanation": "",
        "sql": "SELECT \n    u.name AS employee_name,\n    u.employee_id,\n    COUNT(CASE WHEN a.status = 'present' THEN 1 END) AS present_count,\n    COUNT(CASE WHEN a.status = 'absent' THEN 1 END) AS absent_count,\n    COUNT(CASE WHEN a.status = 'late' THEN 1 END) AS late_count,\n    SUM(a.total_hours) AS work_hours\nFROM attendances a\nJOIN users u ON a.employee_id = u.id\nWHERE a.date BETWEEN '2025-06-01' AND '2025-06-30'\nGROUP BY u.id, u.name, u.employee_id\nORDER BY u.name\nLIMIT 100",
        "title": "SQL Report"
      },
      "sources": {
        "schema_version": "ecb2b73f92f14b42"
      },
