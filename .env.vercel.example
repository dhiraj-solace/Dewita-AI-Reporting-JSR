ENVIRONMENT=production
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4

AI_SQL_ENABLED=true
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

LLM_VALIDATOR_ENABLED=true
LLM_VALIDATOR_PROVIDER=openrouter
LLM_VALIDATOR_OPENROUTER_MODEL=openai/gpt-4.1-mini
LLM_VALIDATOR_STRICT_MODE=false

AUTH_SECRET_KEY=replace-with-a-long-random-secret
DIRECT_ADMIN_ENABLED=true
DIRECT_ADMIN_EMAIL=admin@devita.local
DIRECT_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
CRON_SECRET=replace-with-a-different-long-random-secret
SCHEDULER_ENABLED=false

LLM_SQL_CACHE_ENABLED=false
VECTOR_STORE_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Devita AI Reporting
SMTP_USE_TLS=true
