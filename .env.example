# Backend
# Recommended direct connection string:
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE?charset=utf8mb4

# Or individual fields:
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# AI SQL generation. OpenRouter is the production default. Without a key, the backend uses safe built-in report templates.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Devita AI Reporting
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_SQL_ENABLED=true
MAX_ROWS=500

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:7000
